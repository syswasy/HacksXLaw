      "data": {
        "label": "Step 1: User Profile",
        "config": {
          "factDefinitions": [
            {
              "label": "Role",
              "dataType": "custom",
              "required": true,
              "instructions": "What best describes your role or situation?",
              "customEnumValues": [
                "null",
                "Employee",
                "Employer",
                "Tenant",
                "Landlord",
                "Consumer",
                "Business Owner",
                "Immigrant",
                "Student",
                "Other"
              ],
              "sourcePreference": "either"
            },
            {
              "label": "Jurisdiction",
              "dataType": "text",
              "required": true,
              "instructions": "What province, state, or country applies to your situation?",
              "customEnumValues": [],
              "sourcePreference": "either"
            },
            {
              "label": "Language Preference",
              "dataType": "custom",
              "required": false,
              "instructions": "What language would you like guidance in?",
              "customEnumValues": ["null", "English", "French", "Spanish", "Other"],
              "sourcePreference": "either"
            },
            {
              "label": "Family Status",
              "dataType": "custom",
              "required": false,
              "instructions": "What is your family status?",
              "customEnumValues": ["null", "Single", "Married", "Common-Law", "Divorced", "With Dependents", "Other"],
              "sourcePreference": "either"
            },
            {
              "label": "Employment Status",
              "dataType": "custom",
              "required": false,
              "instructions": "What is your current employment status?",
              "customEnumValues": ["null", "Employed Full-Time", "Employed Part-Time", "Self-Employed", "Unemployed", "Student", "Retired", "Other"],
              "sourcePreference": "either"
            }
          ]
        }
      },
      "measured": { "width": 240, "height": 92 }
    },
    {
      "id": "documents-upload-node",
