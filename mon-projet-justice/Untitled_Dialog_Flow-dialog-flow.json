      "data": {
        "label": "Document Review",
        "config": {
          "question": "What should be done with the uploaded document(s)?",
          "instructions": "Determine the appropriate path based on the documents provided. If there are multiple documents, group them by category and note when a category contains more than one item so they can be summarized together. When a specific document is being opened, identify its document type first, then assess whether there is any urgency, incompleteness, or problem that requires immediate attention. If urgency exists, surface it immediately and prioritize action-oriented advice. If there is no urgency, explain the document in plain language, translate jargon into clear terms, and identify the next concrete step. Keep the user's profile in mind for all recommendations and ensure any resource referral is included whenever it is relevant or helpful.",
          "footnotes": [],
          "dataType": "text",
          "customEnumValues": [],
          "isChildNode": false,
          "children": []
        },
        "prompt": ""
      },
